<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NNTP_Projekt_D25.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="NNTP_Projekt_D25.Views.Login"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="NNTP_Projekt">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
    
    <StackPanel>
        <TextBox Text="{Binding Greeting}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
        <TextBox PlaceholderText="Username" x:Name="box_user">SimonAagaard</TextBox>
        <TextBox PlaceholderText="Password" x:Name="box_pass">pjlmewywy</TextBox>
        <Button HorizontalAlignment="Center" Click="Send_UserPass">Connect</Button>
    </StackPanel>


    
    

</Window>